<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="oval">
                <size android:width="20dp" android:height="20dp" />
                <solid android:color="@color/switch_thumb_on" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="oval">
                <size android:width="20dp" android:height="20dp" />
                <solid android:color="@color/switch_thumb_off" />
            </shape>
        </inset>
    </item>
</selector>
