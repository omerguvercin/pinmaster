<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Açık Durum (Checked) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@color/switch_track_on" />
        </shape>
    </item>
    <!-- Kapalı Durum (Unchecked) -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@color/switch_track_off" />
            <stroke android:width="1.5dp" android:color="@color/card_stroke" />
        </shape>
    </item>
</selector>

