<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="12dp"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Fotoğraf Küçük Önizleme (Thumbnail) -->
    <ImageView
        android:id="@+id/iv_intruder_thumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="#272D45"
        android:layout_marginEnd="14dp" />

    <!-- Bilgiler -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_intruder_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_intruder_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_intruder_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Sil Butonu -->
    <Button
        android:id="@+id/btn_delete_log"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✕"
        android:textSize="14sp"
        android:textColor="@color/accent_red"
        android:background="@drawable/btn_secondary"
        android:stateListAnimator="@null"
        android:padding="0dp" />

</LinearLayout>
