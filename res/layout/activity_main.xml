<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- ══════════════════════════════════════════════
         MOCKUP HEADER (Konsept 1: Cyber-Shield)
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PinMaster"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:letterSpacing="0.02" />

            <!-- Dinamik Kalkan Durumu (Kalkan Aktif / İzin Gerekli) -->
            <TextView
                android:id="@+id/tv_status_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kalkan Aktif"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Mockup Sağ Switch -->
        <com.pinmaster.app.CyberSwitch
            android:id="@+id/switch_master"
            android:layout_width="42dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- İnce Siber Ayırıcı Çizgi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp" />

    <!-- ══════════════════════════════════════════════
         ANA İÇERİK ALANI
    ══════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── 1. UYGULAMALAR SEKME İÇERİĞİ ── -->
        <LinearLayout
            android:id="@+id/view_tab_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Minimal Arama & Aksiyon Barı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:background="@drawable/search_bg"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/btn_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tümü"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:paddingLeft="10dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/btn_clear_selection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temizle"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red"
                    android:paddingLeft="8dp"
                    android:paddingRight="4dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- Kart Listesi (Doğrudan Prototip Düzeni) -->
            <ListView
                android:id="@+id/list_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- ── 2. AYARLAR SEKME İÇERİĞİ ── -->
        <ScrollView
            android:id="@+id/view_tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Titreşim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Titreşim"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kilitleme anında titreşim"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.pinmaster.app.CyberSwitch
                        android:id="@+id/switch_vibrate"
                        android:layout_width="40dp"
                        android:layout_height="22dp" />
                </LinearLayout>

                <!-- Mahremiyet Kalkanı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mahremiyet Kalkanı"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kilitliyken bildirimleri ve durum çubuğunu gizle"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.pinmaster.app.CyberSwitch
                        android:id="@+id/switch_privacy_shield"
                        android:layout_width="40dp"
                        android:layout_height="22dp" />
                </LinearLayout>

                <!-- Çıkış Molası -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Çıkış Molası (Dokunulmazlık)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="8dp"
                        android:text="Donanım tuşlarıyla kilit açıldığında uygulamanın tekrar kilitlenmesini engelleyen süre"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_current_cooldown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Süre: 10 Saniye"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btn_change_cooldown"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Süreyi Değiştir"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- Pil Optimizasyonu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pil Optimizasyonu"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="8dp"
                        android:text="Android'in koruma servisini uyutmaması için pil kısıtlamasını kaldırın."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_battery_optimization"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Pil Ayarlarını Aç"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- Güvenlik Ayarı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sistem Sabitleme Ayarı"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="8dp"
                        android:text="Güvenlik menüsünden Ekrana Sabitleme özelliğini kontrol edin."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_open_security_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Güvenlik Ayarlarını Aç"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- Geliştirici -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GELİŞTİRİCİ"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ömer Güvercin"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_developer_github"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub: github.com/omerguvercin"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ── 3. KILAVUZ SEKME İÇERİĞİ ── -->
        <ScrollView
            android:id="@+id/view_tab_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Kurulum -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Temel Kurulum ve Yetkiler"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ayarlar > Erişilebilirlik menüsünden PinMaster'ı açın. Rootsuz kilit desteği için Shizuku kablosuz hata ayıklama yetkisini verin."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 2. Sabit Kilit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Sabit Kilit Modu"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Uygulama açıldığı anda ekrana kilitlenir; diğer uygulamalara veya ana ekrana geçilemez."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 3. Sayaçlı Kilit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Otomatik Kilit Sayacı"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Kilitli uygulamanın altındaki 'Kilitli' yazısına dokunarak 1-60 dk süre belirleyebilirsiniz; süre dolunca ekran otomatik kilitlenir."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 4. Sahte Uyarı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Sahte Uyarı Modu"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Uygulama açılışında sahte çökme uyarısı verilir. Açmak için 'Uygulamayı kapat' butonuna 1.5 saniye basılı tutulur."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 5. Mahremiyet Kalkanı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Mahremiyet Kalkanı"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Kilitli uygulamalarda üst bildirim çekmecesinin indirilmesi ve durum çubuğu bildirimleri engellenir."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 6. Kilit Çözme -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Kilit Çözme ve Çıkış"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Donanım tuşlarıyla kilit açıldığında uygulama serbest kalır. Kullanıcı uygulamayı tamamen kapatana kadar tekrar kilitlenmez."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ══════════════════════════════════════════════
         MODERN SİBER ALT NAVİGASYON BAR (Bottom Dock)
    ══════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#0A0E18"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:id="@+id/tab_btn_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="UYGULAMALAR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cyan"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AYARLAR"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_btn_guide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="KILAVUZ"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
