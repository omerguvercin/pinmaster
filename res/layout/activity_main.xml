<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- ══════════════════════════════════════════════
         HEADER
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PinMaster"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otomatik Uygulama Kilitleme"
                android:textSize="12sp"
                android:textColor="@color/text_muted"/>
        </LinearLayout>

        <!-- Master switch — sağ üstte -->
        <Switch
            android:id="@+id/switch_master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════
         DURUM KARTI
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kontrol ediliyor..."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tv_status_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"/>

        <!-- ADB komutu — yalnızca DeviceOwner kurulu değilse -->
        <TextView
            android:id="@+id/tv_adb_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="#1500D4AA"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone"/>

        <!-- Erişilebilirlik butonu — yalnızca gerektiğinde -->
        <Button
            android:id="@+id/btn_open_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:text="Erişilebilirliği Aç"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Seçili uygulama sayısı -->
    <TextView
        android:id="@+id/tv_selected_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="6dp"
        android:text="0 Uygulama Seçili"
        android:textSize="12sp"
        android:textColor="@color/text_muted"/>

    <!-- ══════════════════════════════════════════════
         SEKME BUTONLARI
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/tab_btn_apps"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Uygulamalar"
            android:textSize="12sp"
            android:background="@drawable/card_bg"
            android:textColor="@color/accent_cyan"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/tab_btn_settings"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="Ayarlar"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/tab_btn_guide"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Kılavuz"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════
         SEKME İÇERİKLERİ
    ══════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Uygulamalar ── -->
        <LinearLayout
            android:id="@+id/view_tab_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/search_hint"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:inputType="text"/>

            <ListView
                android:id="@+id/list_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:listSelector="@android:color/transparent"/>
        </LinearLayout>

        <!-- ── Ayarlar ── -->
        <ScrollView
            android:id="@+id/view_tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Titreşim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Titreşim"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kilitleme anında titreşim"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_vibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Çıkış PIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Çıkış PIN'i"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="PinMaster logosuna 5 kez dok → bu PIN → kilit kalkar"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tv_current_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mevcut PIN: ••••"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btn_change_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="PIN Değiştir"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <!-- Geliştirici -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GELİŞTİRİCİ"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ömer Güvercin"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="omerguvercinn@gmail.com"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WhatsApp: @omerguvercinn"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ── Kılavuz ── -->
        <ScrollView
            android:id="@+id/view_tab_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="16dp" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="1 — Erişilebilirliği Etkinleştir"
                        android:textColor="@color/accent_cyan" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ayarlar → Erişilebilirlik → PinMaster'ı açın. Bu yeterli — uygulama her boot'ta otomatik başlar."
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="16dp" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2 — Uygulama Seç"
                        android:textColor="@color/accent_cyan" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="'Uygulamalar' sekmesinden kilitlemek istediğiniz uygulamaları seçin."
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="16dp" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3 — Sessiz Mod (Opsiyonel, Önerilen)"
                        android:textColor="@color/accent_cyan" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Telefonu USB'ye takın ve şu komutu çalıştırın:\n\nadb shell dpm set-device-owner com.pinmaster.app/.PinDeviceAdminReceiver\n\nBu işlem yalnızca bir kez yapılır. Sonrasında kilitleme tamamen sessiz olur."
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="4 — Kilitden Çıkış"
                        android:textColor="@color/accent_cyan" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Kilitli uygulamadan çıkmaya çalışınca guard ekranı gelir. PinMaster logosuna 5 kez dokun → PIN girin → kilit kalkar."
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
