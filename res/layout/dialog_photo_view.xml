<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161926"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_dialog_full_photo"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="fitCenter"
        android:background="#0D0F18" />

    <TextView
        android:id="@+id/tv_dialog_log_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_dialog_log_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_red"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_dialog_log_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_dialog_close_photo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Kapat"
        android:textColor="@color/text_primary"
        android:background="@drawable/btn_secondary"
        android:textSize="14sp"
        android:stateListAnimator="@null" />

</LinearLayout>
