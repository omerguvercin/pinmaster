<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!--
         GuardActivity görünmez arka planda çalışır.
         Pinlenmiş uygulama kapandığında öne gelir ve bu içerik görünür.
    -->
    <LinearLayout
        android:id="@+id/guard_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="invisible">

        <!-- Üst boşluk -->
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Logo / 5 kez dokunma tetikleyicisi -->
        <LinearLayout
            android:id="@+id/guard_exit_trigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PinMaster"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🔒  Koruma Aktif"
                android:textSize="12sp"
                android:textColor="@color/accent_cyan"/>
        </LinearLayout>

        <!-- Ayraç -->
        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="@color/accent_cyan"
            android:alpha="0.25"/>

        <!-- Kilitli uygulama bilgisi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp">

            <ImageView
                android:id="@+id/guard_app_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="fitCenter"/>

            <TextView
                android:id="@+id/guard_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"/>

            <!-- "Dön" butonu -->
            <Button
                android:id="@+id/guard_btn_return"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="Uygulamaya Dön"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_gradient"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Alt boşluk -->
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Gizli çıkış ipucu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Logo'ya 5 kez dokun → Yönetici girişi"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:alpha="0.4"/>

    </LinearLayout>

</FrameLayout>
