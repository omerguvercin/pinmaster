<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PinMaster" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent_cyan</item>
        <item name="android:switchStyle">@style/ModernSwitch</item>
    </style>

    <style name="ModernSwitch" parent="android:Widget.CompoundButton">
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:showText">false</item>
    </style>
</resources>
